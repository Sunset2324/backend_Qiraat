# Salin menjadi .env (lokal) atau isi di dashboard hosting. JANGAN commit .env.
PORT=3000
ADMIN_KEY=ganti-dengan-kunci-panjang-acak
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
